---
import githubRepositories from "../utils/projects.json";
import Send from "../svgs/Send.astro";
---

<section>
  <h1 class="eyebrow initial-animation">Proyectos</h1>
  <p class="intro initial-animation">
    Una muestra breve de cómo construyo interfaces, consumo APIs y llevo ideas a producto.
  </p>

  <div class="projects">
    {
      githubRepositories.map((repo) => (
        <a
          href={repo.repoUrl}
          target="_blank"
          rel="noreferrer"
          class="card initial-animation"
        >
          <h3>{repo.name}</h3>
          <p class="desc">{repo.desc}</p>
          <div class="link">
            <Send width="30" height="30" />
          </div>
          <div class="tags">
            {repo.tags.map((tag) => <p class="tag">{tag}</p>)}
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  section {
    margin-top: 10px;
    padding: 20px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.25rem;
    color: var(--color-secundary);
  }

  h2 {
    font-size: 2.8rem;
    margin-top: 10px;
  }

  .intro {
    margin-top: 12px;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .projects {
    margin-top: 25px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
  }

  .link {
    position: absolute;
    top: 5px;
    right: 5px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  h1 {
    font-size: larger;
  }

  .card {
    position: relative;
    width: 350px;
    min-height: 220px;
    background-color: var(--background);
    border: 2px solid var(--color-highlight);
    border-radius: 14px;
    padding: 20px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-highlight) 70%, white 30%);
    box-shadow: 0 14px 28px rgb(15 23 42 / 0.12);
  }

  .desc {
    margin-top: 10px;
    line-height: 1.6;
  }

  .tags {
    margin-top: 14px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tag {
    background-color: var(--color-secundary);
    color: var(--background);
    padding: 10px;
    display: flex;
    align-items: center;
    border-radius: 999px;
  }

  @media (width <= 840px) {
    .projects {
      flex-direction: column;
    }

    .card {
      width: 100%;
      margin: 0 auto;
    }
  }

  @media (width <= 550px) {
    section {
      padding: 16px;
    }

    h2 {
      font-size: 2rem;
    }
  }
</style>
