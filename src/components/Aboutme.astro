---
import Magic from "../svgs/Magic.astro"
import Volleyball from "../svgs/Volleyball.astro"
import Stack from "../svgs/Stack.astro"

---
<section>
  <h1 class="eyebrow initial-animation">Sobre mí</h1>
  <div>
    <p class="initial-animation passions">Tengo experiencia en desarrollo web, tanto backend como frontend, con foco en aplicaciones en producción, APIs REST e integración entre sistemas.</p>
    <p class="initial-animation passions">Trabajo con C#, .NET, ASP.NET Core, Entity Framework Core, React, Next.js, Astro, SQL Server y MySQL. Me especializo en la resolución de incidencias, la mejora del rendimiento y el desarrollo de soluciones mantenibles y escalables.</p>

  </div>
</section>


<style>

  section {
    margin: 0 20px 40px;
    #display: flex;
    #justify-content: center;
  }

  div {
    padding: 5px 50px;
  }

  div p {
    margin: 20px auto;
    font-size: 1.1rem;
    line-height: 150%;
  }

  h1 {
    font-size: larger;
  }

  .comillas {
    color: var(--color-highlight);
  }

  .comillas:nth-child(1) {
    margin-right: 5px;
  }

  .comillas:nth-child(2) {
    margin-left: 5px;
  }

  .highlight {
    color: var(--color-highlight);
    font-weight: bolder;
  }

  p{
    margin-top: 10px;
  }

  .bold {
    font-weight: bolder;
  }

  .passions {
    display: flex;
    align-items: center;
  }

  .passions span {
    margin: 0 5px;
  }

  .mobile-passins {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.25rem;
    color: var(--color-secundary);
  }

  @media (width <= 740px) {
    section {
      margin: 0;
      padding: 30px;
    }
  }

  @media (width <= 717px) {
    .passions span {
      display: none;
    }

    .mobile-passins {
      display: flex;
    }

  }

</style>