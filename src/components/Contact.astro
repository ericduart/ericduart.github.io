---
import ContactSVG from "../svgs/ContactSVG.astro";
---

<footer class="link_block reverseHover initial-animation">
  <a href="mailto:eric.duasan@gmail.com">
    Si crees que puedo aportar a tu equipo, hablemos. <ContactSVG />
  </a>
</footer>

<style>
  footer {
    margin: 50px auto;
    width: fit-content;
    background-color: var(--color-primary);
    padding: 20px 25px;
    font-size: larger;
    border-radius: 5px;
  }

  a {
    color: var(--background);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (width <= 550px) {
    footer {
      margin: 40px 16px;
      width: auto;
      text-align: center;
    }

    a {
      justify-content: center;
    }
  }
</style>
